# Copy to .env.production on the Droplet; never use the local demo's .env.
DOMAIN=gramask.example.com
ACME_EMAIL=admin@example.com
RELEASE_TAG=2026-10-30

# community: every question receives a fresh crowd request.
# knowledge_first: trusted known facts / fresh evidence first, all other topics to students.
QUESTION_ROUTING=knowledge_first
LLM_MODEL=gemma3:4b
LLM_TIMEOUT=300
QUORUM=3
AGREEMENT=0.6
TIMEOUT_MIN=30
LIVE_FRESHNESS_MIN=5
# Optional stricter legacy cap; live answers always expire within LIVE_FRESHNESS_MIN.
FACT_TTL_HOURS=2
SESSION_DAYS=14
ASK_RATE_LIMIT=10
AUTH_RATE_LIMIT=30

# Private proxy network. Change BOTH if this subnet overlaps your server/VPC.
PROXY_SUBNET=172.30.180.0/24
PROXY_IP=172.30.180.2
