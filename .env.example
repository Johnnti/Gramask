# Local configuration. Export these variables before starting Python.
# Docker Compose reads this file when it is copied to .env.
APP_ENV=development
APP_ORIGIN=http://localhost:8000
SECURE_COOKIES=0
PORT=8000
DB_PATH=gramask.db
DEMO_MODE=0
# With DEMO_MODE=1, set this to 1 to use real Gemma instead of offline simulation.
DEMO_LIVE_LLM=0
QUESTION_ROUTING=knowledge_first

# Ollama's native API; run `ollama pull gemma3:4b` first.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_CONCURRENT=2
ALLOW_FALLBACK=0

QUORUM=3
AGREEMENT=0.6
TIMEOUT_MIN=15
LIVE_FRESHNESS_MIN=5
# Optional stricter legacy cap; live answers always expire within LIVE_FRESHNESS_MIN.
FACT_TTL_HOURS=2
SESSION_DAYS=14
ASK_RATE_LIMIT=20
AUTH_RATE_LIMIT=15

# Production: APP_ENV=production, APP_ORIGIN=https://your-domain.example,
# SECURE_COOKIES=1, DEMO_MODE=0. Terminate HTTPS at your reverse proxy.
# Compose binds only localhost unless APP_BIND_ADDRESS is overridden.
APP_BIND_ADDRESS=127.0.0.1
